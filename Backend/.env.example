# Copy to .env and fill in the credentials for YOUR local Postgres.
# .env is gitignored -- it never leaves your machine, so these differ per developer.
#
# A stock Postgres install (Windows/mac installer, Homebrew, most distros) gives you
# a "postgres" superuser whose password you chose during setup -- use those below.
# The database itself does not need to exist; the backend creates it on first run.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=furrever_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
